{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThinkRail Launcher Lite",
  "version": "0.1.0",
  "identifier": "io.github.thinkrail-launcher-lite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ThinkRail Launcher Lite",
        "width": 860,
        "height": 660,
        "minWidth": 800,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "publisher": "ThinkRail Launcher Lite contributors",
    "category": "DeveloperTool",
    "shortDescription": "轻量级 ThinkRail 桌面代理启动器，无需 TUN，不修改系统代理",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "notices/": "licenses/"
    }
  }
}
