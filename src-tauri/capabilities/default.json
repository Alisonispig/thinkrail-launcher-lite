{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-validate-app",
    "allow-probe-proxy",
    "allow-launch-thinkrail",
    "allow-load-config",
    "allow-save-config",
    "allow-set-window-theme",
    "allow-set-close-after-launch",
    "allow-check-update",
    "allow-install-update"
  ]
}
